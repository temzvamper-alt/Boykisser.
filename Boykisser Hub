	beam.Attachment1 = att1
	beam.Parent = root
	entry.Elements.Beam = beam
	entry.Elements.Att0 = att0
	entry.Elements.Att1 = att1

	TargetScanner.Cache[target] = entry
end

function TargetScanner.RemoveTarget(target)
	local entry = TargetScanner.Cache[target]
	if entry then
		for _, elem in pairs(entry.Elements) do
			if elem and elem.Parent then
				elem:Destroy()
			end
		end
		TargetScanner.Cache[target] = nil
	end
end

