-- ПЕРЕТАСКИВАНИЕ ИКОНКИ & ПЛАВНОЕ ОТКРЫТИЕ/ЗАКРЫТИЕ
---------------------------------------------------------
local dragging, dragInput, dragStart, startPos
local isDraggingIcon = false

ToggleIcon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        isDraggingIcon = false
        dragStart = input.Position
        startPos = ToggleIcon.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ToggleIcon.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        if delta.Magnitude > 5 then
            isDraggingIcon = true
        end
        ToggleIcon.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Анимация сворачивания
MinimizeBtn.MouseButton1Click:Connect(function()
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = ToggleIcon.Position
    })
    tween:Play()
    tween.Completed:Connect(function()
        MainFrame.Visible = false
        ToggleIcon.Visible = true
        MainFrame.Size = UDim2.new(0, 480, 0, 340)
    end)
end)

-- Тап по иконке для разворачивания
ToggleIcon.MouseButton1Click:Connect(function()
    if not isDraggingIcon then
        ToggleIcon.Visible = false
        MainFrame.Position = ToggleIcon.Position
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Visible = true

        local targetPos = UDim2.new(0.5, -240, 0.5, -170)
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 480, 0, 340),
            Position = targetPos
        })
        tween:Play()
    end
end)

-- Полный выход (крестик)
CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

