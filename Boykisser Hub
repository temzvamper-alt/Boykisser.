local function AddTabButton(name, icon, active, order)
    local btn = Instance.new("Frame", Sidebar)
    btn.Size = UDim2.new(0.88, 0, 0, 32)
    btn.BackgroundColor3 = active and Color3.fromRGB(30, 30, 35) or Color3.fromRGB(14, 14, 16)
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    
    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 6)
    
    if active then
        local indicator = Instance.new("Frame", btn)
        indicator.Size = UDim2.new(0, 3, 0, 16)
        indicator.Position = UDim2.new(0, 2, 0.5, -8)
        indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Instance.new("UICorner", indicator).CornerRadius = UDim.new(0, 2)
    end
    
    local txt = Instance.new("TextLabel", btn)
    txt.Text = icon .. "  " .. name
    txt.Size = UDim2.new(1, -10, 1, 0)
    txt.Position = UDim2.new(0, 10, 0, 0)
    txt.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(120, 120, 130)
    txt.Font = Enum.Font.GothamSemibold
    txt.TextSize = 12
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.BackgroundTransparency = 1
end

