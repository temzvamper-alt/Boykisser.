	txt.BackgroundTransparency = 1
	txt.TextColor3 = Config.Visuals.Labels.TextColor
	txt.TextSize = Config.Visuals.Labels.TextSize
	txt.Font = Enum.Font.SourceSansBold
	txt.TextStrokeTransparency = 0.2
	txt.Parent = labelFrame

	local healthBarBg = Instance.new("Frame")
	healthBarBg.Name = "HealthBarBg"
	healthBarBg.Size = UDim2.new(0.8, 0, 0, 4)
	healthBarBg.Position = UDim2.new(0.1, 0, 0.75, 0)
	healthBarBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	healthBarBg.BorderSizePixel = 0
	healthBarBg.Parent = labelFrame

	local healthBarFill = Instance.new("Frame")
	healthBarFill.Name = "Fill"
	healthBarFill.Size = UDim2.new(1, 0, 1, 0)
