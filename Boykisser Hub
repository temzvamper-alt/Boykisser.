local function applySafeImage(imageLabel, assetId, fallbackText)
    local loaded = false
    pcall(function()
        imageLabel.Image = assetId
        loaded = true
    end)
    if not loaded or imageLabel.Image == "" then
        imageLabel.BackgroundTransparency = 0
        imageLabel.BackgroundColor3 = Theme.PanelBG
        local txt = Instance.new("TextLabel")
        txt.Parent = imageLabel
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.Text = fallbackText or "🐱"
        txt.TextColor3 = Theme.SoftPink
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 16
    end
end

