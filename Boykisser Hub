	local tabFrame = GUIBuilder.CreateElement("ScrollingFrame", {
		Name = "Page_" .. tabId,
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.new(0, 6, 0, 6),
		BackgroundTransparency = 1,
		Visible = false,
		CanvasSize = UDim2.new(0, 0, 2, 0),
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = theme.Accent,
		Parent = GUIBuilder.ContentContainer
	})

	GUIBuilder.CreateElement("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = tabFrame
	})

	GUIBuilder.TabButtons[tabId] = btn
	GUIBuilder.TabFrames[tabId] = tabFrame

	btn.MouseButton1Click:Connect(function()
		GUIBuilder.SelectTab(tabId)
	end)
end

function GUIBuilder.SelectTab(tabId)
	local theme = Config.UI.Theme
	for id, btn in pairs(GUIBuilder.TabButtons) do
		if id == tabId then
			AnimationEngine.Tween(btn, 0.2, { BackgroundColor3 = theme.Accent, TextColor3 = theme.Text })
			GUIBuilder.TabFrames[id].Visible = true
		else
			AnimationEngine.Tween(btn, 0.2, { BackgroundColor3 = theme.Container, TextColor3 = theme.TextMuted })
			GUIBuilder.TabFrames[id].Visible = false
		end
	end
	GUIBuilder.ActiveTab = tabId
end

