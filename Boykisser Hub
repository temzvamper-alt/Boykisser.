UserInputService.JumpRequest:Connect(function()
    if InfJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid:ChangeState("Jumping")
    end
end)

local AirPart = Instance.new("Part")
AirPart.Size = Vector3.new(6, 1, 6)
AirPart.Transparency = 0.8
AirPart.Anchored = true
AirPart.Color = Color3.fromRGB(255, 255, 255)

local Light = Instance.new("PointLight")

RunService.RenderStepped:Connect(function()
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if hum then hum.WalkSpeed = WalkSpeedVal end
        if hum and hum.UseJumpPower then hum.JumpPower = JumpPowerVal end

        if Noclip then
            for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        if Fly and hrp then
            hrp.Velocity = Vector3.new(0, 0.1, 0)
        end

        if AirWalk and hrp then
            AirPart.Position = hrp.Position - Vector3.new(0, 3.5, 0)
        elseif not AirWalk then
            AirPart.Position = Vector3.new(0, -500, 0)
        end

        if AntiFling then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    for _, p in pairs(player.Character:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end
        end

        if Fullbright and hrp then
            Light.Parent = hrp
            Light.Range = 200
            Light.Brightness = 3
        else
            Light.Parent = nil
        end

        if Freecam then
            Camera.CameraType = Enum.CameraType.Scriptable
            Camera.CFrame = Camera.CFrame * CFrame.new(0, 0, -1)
        elseif not Freecam and Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Custom
        end
    end
end)
