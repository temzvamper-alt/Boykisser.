-- Загрузка библиотеки WindUI
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

-- Создание главного окна
local Window = WindUI:CreateWindow({
    Title = "MM2 Delta Hub 🔪",
    Icon = "rbxassetid://10723345862", -- Иконка
    Author = "by Твой Брат",
    Folder = "MM2_Delta_Config",
    Size = UDim2.fromOffset(580, 360),
    Transparent = true,
    Theme = "Dark", -- Тёмная неоновая тема
    SideBarWidth = 170,
    HasOutline = true
})

-- Сервисы Roblox
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Создание вкладок
local MainTab = Window:Tab({ Title = "Главная", Icon = "user" })
local VisualsTab = Window:Tab({ Title = "Визуалы (ESP)", Icon = "eye" })

-- Переменные
local speedEnabled = false
local currentSpeed = 32
local espEnabled = false

-- ==================== ВКЛАДКА ГЛАВНАЯ ====================

MainTab:Toggle({
    Title = "Включить Спидхак",
    Desc = "Увеличивает скорость перемещения",
    Value = false,
    Callback = function(Value)
        speedEnabled = Value
        if not Value and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 16
        end
    end
})

MainTab:Slider({
    Title = "Скорость движения",
    Value = 32,
    Min = 16,
    Max = 100,
    Step = 1,
    Callback = function(Value)
        currentSpeed = Value
    end
})

-- ==================== ВКЛАДКА ESP ====================

local function getRoleColor(player)
    if not player.Character then return Color3.fromRGB(255, 255, 255) end
    if player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife") then
        return Color3.fromRGB(255, 55, 55) -- Убийца (Красный)
    elseif player.Backpack:FindFirstChild("Gun") or player.Character:FindFirstChild("Gun") then
        return Color3.fromRGB(55, 155, 255) -- Шериф (Синий)
    else
        return Color3.fromRGB(55, 255, 120) -- Мирный (Зеленый)
    end
end

VisualsTab:Toggle({
    Title = "ESP Ролей (Подсветка)",
    Desc = "Показывает местоположение и роли игроков сквозь стены",
    Value = false,
    Callback = function(Value)
        espEnabled = Value
        if not Value then
            for _, player in pairs(Players:GetPlayers()) do
                if player.Character and player.Character:FindFirstChild("MM2_WindHighlight") then
                    player.Character.MM2_WindHighlight:Destroy()
                end
            end
        end
    end
})

-- ==================== ОСНОВНОЙ ЦИКЛ ====================

RunService.RenderStepped:Connect(function()
    -- Применение скорости
    if speedEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = currentSpeed
    end

    -- Применение ESP
    if espEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local highlight = player.Character:FindFirstChild("MM2_WindHighlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "MM2_WindHighlight"
                    highlight.Parent = player.Character
                end
                highlight.FillColor = getRoleColor(player)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.4
            end
        end
    end
end)

-- Красивое уведомление
WindUI:Notify({
    Title = "MM2 Hub Успешно запущен!",
    Content = "Приятной игры, брат! Всё работает на ура.",
    Duration = 4,
    Icon = "check"
})
