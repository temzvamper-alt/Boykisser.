SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
    local text = string.lower(SearchInput.Text)
    if text == "" then
        SearchOverlay.Visible = false
        return
    end

    SearchOverlay.Visible = true
    for _, child in pairs(SearchOverlay:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for pName, pFrame in pairs(pages) do
        for _, elem in pairs(pFrame:GetChildren()) do
            if elem:IsA("Frame") and elem:FindFirstChildOfClass("TextLabel") then
                local labelText = string.lower(elem:FindFirstChildOfClass("TextLabel").Text)
                if string.find(labelText, text) then
                    local clone = elem:Clone()
                    clone.Parent = SearchOverlay
                end
            end
        end
    end
end)

