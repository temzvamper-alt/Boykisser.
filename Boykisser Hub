-- Перетаскивание иконы и анимация
local dragging, dragInput, dragStart, startPos
local isDraggingIcon = false

ToggleIcon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        isDraggingIcon = false
        dragStart = input.Position
        startPos = ToggleIcon.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ToggleIcon.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        if delta.Magnitude > 5 then
            isDraggingIcon = true
        end
        ToggleIcon.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

MinimizeBtn.MouseButton1Click:Connect(function()
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = ToggleIcon.Position
    })
    tween:Play()
    tween.Completed:Connect(function()
        MainFrame.Visible = false
        ToggleIcon.Visible = true
        MainFrame.Size = UDim2.new(0, 620, 0, 380)
    end)
end)

ToggleIcon.MouseButton1Click:Connect(function()
    if not isDraggingIcon then
        ToggleIcon.Visible = false
        MainFrame.Position = ToggleIcon.Position
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Visible = true

        local targetPos = UDim2.new(0.5, -310, 0.5, -190)
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 620, 0, 380),
            Position = targetPos
        })
        tween:Play()
    end
end)

