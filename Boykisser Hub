local Utils = {}

function Utils.IsAlive(inst)
	return inst and inst:IsDescendantOf(Roblox)
end

function Utils.GetRootPart(target)
	if not Utils.IsAlive(target) then return nil end
	if target:IsA("BasePart") then return target end
	if target:IsA("Model") then
		return target.PrimaryPart 
			or target:FindFirstChild("HumanoidRootPart") 
			or target:FindFirstChild("Torso")
			or target:FindFirstChildUpper("UpperTorso")
			or target:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

function Utils.GetHumanoid(target)
	if not Utils.IsAlive(target) then return nil end
	if target:IsA("Model") then
		return target:FindFirstChildOfClass("Humanoid")
	elseif target:IsA("BasePart") then
		local parent = target.Parent
		return parent and parent:FindFirstChildOfClass("Humanoid") or nil
	end
	return nil
end

function Utils.Clamp(val, min, max)
	if val < min then return min end
	if val > max then return max end
	return val
end

function Utils.Lerp(a, b, t)
	return a + (b - a) * t
end

function Utils.ColorToHSV(color)
	return Color3.toHSV(color)
end

function Utils.HSVToColor(h, s, v)
	return Color3.fromHSV(h, s, v)
end

function Utils.DeepCopy(tbl)
	if type(tbl) ~= "table" then return tbl end
	local copy = {}
	for k, v in pairs(tbl) do
		copy[Utils.DeepCopy(k)] = Utils.DeepCopy(v)
	end
	return copy
end

function Utils.Round(num, decimals)
	local mult = 10^(decimals or 0)
	return math.floor(num * mult + 0.5) / mult
end

