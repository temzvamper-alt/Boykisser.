-- Hold-to-Drag Implementation (2 Seconds Hold Requirement)
local function attachHoldToDrag(targetWindow, dragTrigger)
    local dragging = false
    local dragStart, startPos
    local holdTimer = nil

    dragTrigger.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            holdTimer = task.delay(2, function()
                dragging = true
                dragStart = input.Position
                startPos = targetWindow.Position
                TweenService:Create(targetWindow, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}):Play()
            end)
        end
    end)

    dragTrigger.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if holdTimer then task.cancel(holdTimer) end
            dragging = false
            TweenService:Create(targetWindow, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            targetWindow.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

