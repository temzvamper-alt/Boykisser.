function GUIBuilder.CreateToggle(tabId, text, defaultValue, callback)
	local theme = Config.UI.Theme
	local parentFrame = GUIBuilder.TabFrames[tabId]
	if not parentFrame then return end

	local frame = GUIBuilder.CreateElement("Frame", {
		Name = "Toggle_" .. text,
		Size = UDim2.new(1, -8, 0, 36),
		BackgroundColor3 = theme.Sidebar,
		Parent = parentFrame
	})
	GUIBuilder.CreateElement("UICorner", { CornerRadius = UDim.new(0, 6), Parent = frame })
	GUIBuilder.CreateElement("UIStroke", { Color = theme.ItemBorder, Thickness = 1, Parent = frame })

	local label = GUIBuilder.CreateElement("TextLabel", {
		Size = UDim2.new(0.7, 0, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = theme.Text,
		TextSize = 14,
		Font = Enum.Font.SourceSansSemibold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame
	})

	local toggleBtn = GUIBuilder.CreateElement("TextButton", {
		Size = UDim2.new(0, 44, 0, 22),
		Position = UDim2.new(1, -54, 0.5, -11),
		BackgroundColor3 = defaultValue and theme.Accent or theme.Container,
		Text = "",
		Parent = frame
	})
	GUIBuilder.CreateElement("UICorner", { CornerRadius = UDim.new(1, 0), Parent = toggleBtn })

	local indicator = GUIBuilder.CreateElement("Frame", {
		Size = UDim2.new(0, 16, 0, 16),
		Position = defaultValue and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
		BackgroundColor3 = theme.Text,
		Parent = toggleBtn
	})
	GUIBuilder.CreateElement("UICorner", { CornerRadius = UDim.new(1, 0), Parent = indicator })

	local state = defaultValue
	toggleBtn.MouseButton1Click:Connect(function()
		state = not state
		if state then
			AnimationEngine.Tween(toggleBtn, 0.2, { BackgroundColor3 = theme.Accent })
			AnimationEngine.Tween(indicator, 0.2, { Position = UDim2.new(1, -19, 0.5, -8) })
		else
			AnimationEngine.Tween(toggleBtn, 0.2, { BackgroundColor3 = theme.Container })
			AnimationEngine.Tween(indicator, 0.2, { Position = UDim2.new(0, 3, 0.5, -8) })
		end
		callback(state)
	end)
end

function GUIBuilder.CreateSlider(tabId, text, min, max, defaultValue, callback)
	local theme = Config.UI.Theme
	local parentFrame = GUIBuilder.TabFrames[tabId]
	if not parentFrame then return end

	local frame = GUIBuilder.CreateElement("Frame", {
		Name = "Slider_" .. text,
		Size = UDim2.new(1, -8, 0, 48),
		BackgroundColor3 = theme.Sidebar,
		Parent = parentFrame
	})
	GUIBuilder.CreateElement("UICorner", { CornerRadius = UDim.new(0, 6), Parent = frame })
	GUIBuilder.CreateElement("UIStroke", { Color = theme.ItemBorder, Thickness = 1, Parent = frame })

	local label = GUIBuilder.CreateElement("TextLabel", {
		Size = UDim2.new(0.6, 0, 0, 20),
		Position = UDim2.new(0, 10, 0, 4),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = theme.Text,
		TextSize = 14,
		Font = Enum.Font.SourceSansSemibold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame
	})

	local valLabel = GUIBuilder.CreateElement("TextLabel", {
		Size = UDim2.new(0.3, 0, 0, 20),
		Position = UDim2.new(0.7, -10, 0, 4),
		BackgroundTransparency = 1,
		Text = tostring(defaultValue),
		TextColor3 = theme.Accent,
		TextSize = 14,
		Font = Enum.Font.SourceSansBold,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame
	})

	local track = GUIBuilder.CreateElement("Frame", {
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 0, 32),
		BackgroundColor3 = theme.Container,
		Parent = frame
	})
	GUIBuilder.CreateElement("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

	local startPercent = Utils.Clamp((defaultValue - min) / (max - min), 0, 1)

	local fill = GUIBuilder.CreateElement("Frame", {
		Size = UDim2.new(startPercent, 0, 1, 0),
		BackgroundColor3 = theme.Accent,
		Parent = track
	})
	GUIBuilder.CreateElement("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

	local dragging = false

	local function updateSlider(input)
		local posX = input.Position.X - track.AbsolutePosition.X
		local percent = Utils.Clamp(posX / track.AbsoluteSize.X, 0, 1)
		local value = Utils.Round(min + (max - min) * percent, 1)

		fill.Size = UDim2.new(percent, 0, 1, 0)
		valLabel.Text = tostring(value)
		callback(value)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			updateSlider(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			updateSlider(input)
		end
	end)
end

