	bb.Parent = root
	entry.Elements.Billboard = bb
	entry.Elements.TextLabel = txt
	entry.Elements.HealthBarFill = healthBarFill
	entry.Elements.HealthBarBg = healthBarBg

	-- 3. Beam (Visual Connection)
	local att0 = Instance.new("Attachment")
	att0.Name = "BK_Att0"
