		Target = target,
		Root = root,
		Humanoid = Utils.GetHumanoid(target),
		Elements = {}
	}

	-- 1. Highlight (Chams)
	local hl = Instance.new("Highlight")
	hl.Name = "BK_Chams"
	hl.Adornee = target
	hl.Parent = target
	entry.Elements.Highlight = hl

	-- 2. BillboardGui (Labels & HealthBar)
