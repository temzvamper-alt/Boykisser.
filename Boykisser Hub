SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
    local text = string.lower(SearchInput.Text)
    if text == "" then
        SearchOverlay.Visible = false
        return
    end

    SearchOverlay.Visible = true
    for _, child in pairs(SearchOverlay:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end

    for pName, pFrame in pairs(pages) do
        for _, elem in pairs(pFrame:GetChildren()) do
            if elem:IsA("GuiObject") and elem.Name ~= "CatHeader" then
                local elemText = ""
                local label = elem:FindFirstChildOfClass("TextLabel")
                if label then
                    elemText = label.Text
                elseif elem:IsA("TextButton") then
                    elemText = elem.Text
                end

                if string.find(string.lower(elemText), text) then
                    local clone = elem:Clone()
                    clone.Parent = SearchOverlay
                end
            end
        end
    end
end)

