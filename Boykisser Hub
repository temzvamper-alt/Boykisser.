-- 12. FPS Booster
CreateButton("🚀 FPS Booster (Оптимизация)", function()
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("Texture") or obj:IsA("Decal") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
        end
    end
end)

---------------------------------------------------------
-- ГЛАВНЫЙ ИГРОВОЙ ЦИКЛ (RENDERSTEPPED)
---------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if hum then
            hum.WalkSpeed = WalkSpeedVal
        end

        -- Noclip
        if Noclip then
            for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        -- Fly
        if Fly and hrp then
            hrp.Velocity = Vector3.new(0, 0.1, 0)
        end

        -- Air Walk
        if AirWalk and hrp then
            AirPart.Position = hrp.Position - Vector3.new(0, 3.5, 0)
        end

        -- Anti Fling
        if AntiFling then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    for _, p in pairs(player.Character:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end
        end

        -- Freecam Управление
        if Freecam and hrp then
            Camera.CFrame = Camera.CFrame * CFrame.new(0, 0, -1)
        end
    end
end)

