--================================================================================
-- [SECTION 12] МЕНЕДЖЕР ГЛАВНОГО ЦИКЛА (MAIN ENGINE LOOP)
--================================================================================

local MainEngine = {
	LastScan = 0
}

function MainEngine.Start()
	AimbotEngine.Init()
	GUIBuilder.BuildMainUI()
	GUIBuilder.PopulateUI()

	RunService.Heartbeat:Connect(function()
		-- 1. Сканирование мира с заданным интервалом
		if os.clock() - MainEngine.LastScan >= Config.Targeting.ScanInterval then
			TargetScanner.Scan()
			MainEngine.LastScan = os.clock()
		end

		-- 2. Обновление визуалов
		VisualRenderEngine.Update()

		-- 3. Обновление физики
		PhysicsEngine.Update()

		-- 4. Обновление Аимбота
		AimbotEngine.Update()
	end)

	print(string.format("[%s] Успешно запущен! Скрипт готов к работе.", BoykisserHub.ProjectName))
end

-- Автоматический запуск ядра
MainEngine.Start()

return BoykisserHub
