local TargetScanner = {
	Cache = {},
	Connections = {}
}

function TargetScanner.IsValidTarget(inst)
	if not Utils.IsAlive(inst) then return false end
	if LocalPlayer and LocalPlayer.Character and inst:IsDescendantOf(LocalPlayer.Character) then return false end
	
	local root = Utils.GetRootPart(inst)
	if not root then return false end

	if not Config.Targeting.IncludePlayers then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character and inst:IsDescendantOf(p.Character) then
				return false
			end
		end
	end

	local tagged = CollectionService:HasTag(inst, Config.Targeting.TagName)
	local attr = inst:GetAttribute(Config.Targeting.AttributeName) == true
	
	return tagged or attr
end

function TargetScanner.Scan()
	local found = {}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		local model = obj:IsA("BasePart") and (obj:FindFirstAncestorOfClass("Model") or obj) or obj
		if TargetScanner.IsValidTarget(model) then
			found[model] = true
			if not TargetScanner.Cache[model] then
				TargetScanner.AddTarget(model)
			end
		end
	end

	for cachedTarget, _ in pairs(TargetScanner.Cache) do
		if not found[cachedTarget] or not Utils.IsAlive(cachedTarget) then
			TargetScanner.RemoveTarget(cachedTarget)
		end
	end
end

