local VisualRenderEngine = {}

function VisualRenderEngine.Update()
	for target, entry in pairs(TargetScanner.Cache) do
		if not Utils.IsAlive(target) then
			TargetScanner.RemoveTarget(target)
		else
			local root = entry.Root
			local hum = entry.Humanoid or Utils.GetHumanoid(target)
			local elems = entry.Elements

			-- Update Chams
			if elems.Highlight then
				elems.Highlight.Enabled = Config.Visuals.Chams.Enabled
				elems.Highlight.FillColor = Config.Visuals.Chams.FillColor
				elems.Highlight.OutlineColor = Config.Visuals.Chams.OutlineColor
				elems.Highlight.FillTransparency = Config.Visuals.Chams.FillTransparency
				elems.Highlight.OutlineTransparency = Config.Visuals.Chams.OutlineTransparency
				elems.Highlight.DepthMode = Config.Visuals.Chams.AlwaysOnTop 
					and Enum.HighlightDepthMode.AlwaysOnTop 
					or Enum.HighlightDepthMode.Occluded
			end

			-- Update Labels & Health
			if elems.Billboard then
				elems.Billboard.Enabled = Config.Visuals.Labels.Enabled
				elems.Billboard.StudsOffset = Config.Visuals.Labels.Offset

				if elems.TextLabel then
					elems.TextLabel.TextColor3 = Config.Visuals.Labels.TextColor
					elems.TextLabel.TextSize = Config.Visuals.Labels.TextSize

					local str = ""
					if Config.Visuals.Labels.ShowName then
						str = str .. target.Name .. "\n"
					end

					if Config.Visuals.Labels.ShowDistance and LocalPlayer.Character and Utils.GetRootPart(LocalPlayer.Character) then
						local myPos = Utils.GetRootPart(LocalPlayer.Character).Position
						local dist = math.floor((root.Position - myPos).Magnitude)
						str = str .. "[" .. tostring(dist) .. " Studs] "
					end

					if Config.Visuals.Labels.ShowHealth and hum then
						str = str .. "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
					end

					elems.TextLabel.Text = str
				end

				if elems.HealthBarBg and elems.HealthBarFill then
					elems.HealthBarBg.Visible = Config.Visuals.Labels.ShowHealthBar
					if hum and hum.MaxHealth > 0 then
						local hpPercent = Utils.Clamp(hum.Health / hum.MaxHealth, 0, 1)
						elems.HealthBarFill.Size = UDim2.new(hpPercent, 0, 1, 0)
						elems.HealthBarFill.BackgroundColor3 = Color3.fromHSV(hpPercent * 0.3, 0.9, 0.9)
					end
				end
			end

			-- Update Beams
			if elems.Beam then
				elems.Beam.Enabled = Config.Visuals.Beams.Enabled
				elems.Beam.Color = ColorSequence.new(Config.Visuals.Beams.ColorStart, Config.Visuals.Beams.ColorEnd)
				elems.Beam.Width0 = Config.Visuals.Beams.Width0
				elems.Beam.Width1 = Config.Visuals.Beams.Width1
				elems.Beam.TextureSpeed = Config.Visuals.Beams.TextureSpeed
			end
		end
	end
end

