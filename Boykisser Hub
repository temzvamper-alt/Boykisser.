local function addInput(page, text, placeholder, callback)
    local row = Instance.new("Frame")
    row.Name = "Elem_" .. text
    row.Parent = page
    row.BackgroundColor3 = Color3.fromRGB(28, 26, 32)
    row.Size = UDim2.new(1, -10, 0, 42)

    local rowCorner = Instance.new("UICorner")
    rowCorner.CornerRadius = UDim.new(0, 8)
    rowCorner.Parent = row

    local inputField = Instance.new("TextBox")
    inputField.Parent = row
    inputField.BackgroundColor3 = Color3.fromRGB(40, 37, 46)
    inputField.Position = UDim2.new(0, 10, 0, 6)
    inputField.Size = UDim2.new(1, -20, 0, 30)
    inputField.Font = Enum.Font.Gotham
    inputField.PlaceholderText = placeholder or text
    inputField.PlaceholderColor3 = Color3.fromRGB(130, 130, 140)
    inputField.Text = ""
    inputField.TextColor3 = Theme.MetallicWhite
    inputField.TextSize = 12

    local fieldCorner = Instance.new("UICorner")
    fieldCorner.CornerRadius = UDim.new(0, 6)
    fieldCorner.Parent = inputField

    inputField.FocusLost:Connect(function(enterPressed)
        if enterPressed then callback(inputField.Text) end
    end)
end

