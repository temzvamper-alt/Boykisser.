local AimbotEngine = {
	FOVCircle = nil
}

function AimbotEngine.Init()
	-- FOV Circle
	local fovFrame = Instance.new("Frame")
	fovFrame.Name = "BK_FOVCircle"
	fovFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	fovFrame.BackgroundTransparency = 1
	fovFrame.Size = UDim2.new(0, Config.Aimbot.FieldOfView * 2, 0, Config.Aimbot.FieldOfView * 2)
	fovFrame.Position = UDim2.new(0.5, 0, 0.5, 0)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Config.Aimbot.FOVColor
	stroke.Thickness = 1.5
	stroke.Parent = fovFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = fovFrame

	if TargetGuiParent then
		local fovGui = Instance.new("ScreenGui")
		fovGui.Name = "BK_FOVGui"
		fovGui.ResetOnSpawn = false
		fovFrame.Parent = fovGui
		fovGui.Parent = TargetGuiParent
	end

	AimbotEngine.FOVCircle = fovFrame
end

function AimbotEngine.GetClosestTarget()
	local cam = Workspace.CurrentCamera
	if not cam then return nil end

	local mousePos = UserInputService:GetMouseLocation()
	local closest = nil
	local shortestDist = Config.Aimbot.FieldOfView

	for target, entry in pairs(TargetScanner.Cache) do
		local root = entry.Root
		if root then
			local screenPos, onScreen = cam:WorldToViewportPoint(root.Position)
			if onScreen then
				local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					closest = target
				end
			end
		end
	end
	return closest
end

function AimbotEngine.Update()
	if AimbotEngine.FOVCircle then
		AimbotEngine.FOVCircle.Visible = Config.Aimbot.ShowFOV and Config.Aimbot.Enabled
		AimbotEngine.FOVCircle.Size = UDim2.new(0, Config.Aimbot.FieldOfView * 2, 0, Config.Aimbot.FieldOfView * 2)
		local stroke = AimbotEngine.FOVCircle:FindFirstChildOfClass("UIStroke")
		if stroke then stroke.Color = Config.Aimbot.FOVColor end
	end

	if Config.Aimbot.Enabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local target = AimbotEngine.GetClosestTarget()
		if target then
			local root = Utils.GetRootPart(target)
			local cam = Workspace.CurrentCamera
			if root and cam then
				local targetCF = CFrame.new(cam.CFrame.Position, root.Position)
				cam.CFrame = cam.CFrame:Lerp(targetCF, Config.Aimbot.Smoothness)
			end
		end
	end
end

