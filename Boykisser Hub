        Size = UDim2.new(1, 0, 0, 55)
    }):Play()

    -- Анимация полосы прогресса
    TweenService:Create(ProgressBar, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 0, 0, 3)
    }):Play()

